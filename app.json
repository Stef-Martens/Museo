{
  "expo": {
    "name": "Museo",
    "slug": "museo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "museo",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.museo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Museo uses your camera to identify artworks in museums."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.museo.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Museo to access your camera to identify artworks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
